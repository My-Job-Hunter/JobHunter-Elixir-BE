# Job Hunter backend's env file: copy to the host's .env, fill in, chmod 600.
# `export` on every line: the release is a child of the shell that sources this.
# A change needs a restart, not a rebuild. `config/runtime.exs` reads these and
# refuses to boot production without the required ones.

# ============================== REQUIRED =====================================

# ecto://USER:PASS@HOST:5432/job_hunter_prod
export DATABASE_URL=CHANGE_ME

# >= 64 bytes each (`mix phx.gen.secret`), different from each other and per environment.
export SECRET_KEY_BASE=CHANGE_ME
export GUARDIAN_SECRET_KEY=CHANGE_ME_DIFFERENT_FROM_ABOVE

# The apps that may call the API and open its socket, comma-separated: the
# team console and the customer portal. An allowlist, never `*`.
export CORS_ORIGINS=https://team.example.com,https://portal.example.com

# Uploaded files (P1: photos, CVs). A directory on persistent storage, OUTSIDE
# the release directory, owned by the user this runs as.
export UPLOADS_ROOT=/home/ubuntu/sites/job-hunter/uploads

# ============================== OPTIONAL =====================================

# Where the mails' links open (P1): the console, and the portal when it differs.
# export CONSOLE_URL=https://team.example.com
# export PORTAL_URL=https://portal.example.com

# *Continue with Google* (P1). Unset: no Google sign-in in a release.
# export GOOGLE_CLIENT_ID=....apps.googleusercontent.com

# The envelope sender (P1): a domain the mail provider is authorised for.
# export MAILER_FROM_EMAIL=hello@example.com

# Must match proxy_pass in this host's reverse proxy. Default 4100.
# export PORT=4100
# export POOL_SIZE=10
# emergency | alert | critical | error | warning | notice | info | debug
# export LOG_LEVEL=info

# The mail provider (P7) and the OAuth secrets (P9) add their variables here
# with the phase that reads them.
