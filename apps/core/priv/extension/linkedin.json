{
  "site": "linkedin",
  "contract": 1,
  "pages": {
    "job": {
      "url": ["/jobs/view/", "currentJobId="],
      "ready": [
        ".job-details-jobs-unified-top-card__job-title",
        ".jobs-unified-top-card__job-title",
        ".jobs-details__main-content h1",
        ".top-card-layout__title",
        "[data-view-name='job-details'] h1",
        ".jobs-search__job-details--wrapper h1"
      ]
    },
    "search": {
      "url": ["/jobs/search", "/jobs/collections"],
      "ready": [".jobs-search-results-list", ".scaffold-layout__list", "[data-view-name='job-search-results']"]
    },
    "thread": {
      "url": ["re:^/messaging/thread/(?!new(?:/|$))([^/?#]+)"],
      "ready": [
        ".msg-s-message-list-content",
        ".msg-s-message-list",
        ".msg-thread",
        "[data-view-name='message-list']",
        "main .msg-convo-wrapper"
      ]
    }
  },
  "fields": {
    "title": {
      "on": "job",
      "css": [
        ".job-details-jobs-unified-top-card__job-title h1",
        ".job-details-jobs-unified-top-card__job-title",
        ".jobs-unified-top-card__job-title",
        ".top-card-layout__title",
        "[data-view-name='job-details'] h1",
        ".jobs-details__main-content h1"
      ],
      "read": "text",
      "required": true
    },
    "company_name": {
      "on": "job",
      "css": [
        ".job-details-jobs-unified-top-card__company-name a",
